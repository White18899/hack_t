# =======================================================
# INFINITY HACKATHON 2026 - ENVIRONMENT CONFIGURATION
# =======================================================

# Cloudflare R2 Credentials (Optional for local development)
# If left blank, the platform automatically uses the persistent local file-based storage.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=hackathon-infinity-uploads
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# Organizer Administration Secret Passphrase (default is "admin123")
ADMIN_SECRET=admin123

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
